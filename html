/ ── навигация ── /

.nav{

position:sticky;top:0;z-index:50;

backdrop-filter:blur(14px);

background:rgba(5,9,18,.78);

border-bottom:1px solid var(--line);

}

.nav__in{display:flex;align-items:center;gap:22px;padding:12px 0;overflow-x:auto}

.nav__brand{font-weight:800;letter-spacing:.06em;font-size:13px;white-space:nowrap;color:#fff}

.nav__brand span{color:var(--cy)}

.nav a{font-size:14px;color:var(--muted);white-space:nowrap}

.nav a:hover{color:var(--cy);text-decoration:none}

/ ── секции ── /

section{padding:clamp(48px,7vw,92px) 0;scroll-margin-top:70px}

.eyebrow{

display:inline-block;font-size:12px;letter-spacing:.18em;text-transform:uppercase;

color:var(--cy);border:1px solid rgba(78,240,255,.35);border-radius:999px;

