}

.stat b{display:block;font-size:clamp(19px,2.4vw,26px);color:#fff;letter-spacing:-.01em}

.stat small{color:var(--muted);font-size:12.5px;line-height:1.35;display:block}

/ ── 3D голограмма ── /

.holo{display:grid;place-items:center;position:relative;min-height:340px}

.holo__glow{

position:absolute;inset:auto 0 4% 0;height:180px;

background:radial-gradient(closest-side, rgba(78,240,255,.28), transparent 72%);

filter:blur(14px);pointer-events:none;

}

.holo__base{

position:absolute;bottom:6%;width:min(280px,72%);height:26px;border-radius:50%;

border:1px solid rgba(78,240,255,.45);

box-shadow:0 0 40px rgba(78,240,255,.35), inset 0 0 30px rgba(78,240,255,.2);

}

.scan{

position:absolute;inset:0;pointer-events:none;opacity:.35;mix-blend-mode:screen;

background:repeating-linear-gradient(180deg, rgba(78,240,255,.16) 0 1px, transparent 1px 4px);

animation:scan 7s linear infinite;

}

@keyframes scan{to{background-position-y:400px}}

.cube{perspective:900px}

.cube__box{

position:relative;width:var(--s,150px);height:var(--s,150px);

transform-style:preserve-3d;

animation:spin 26s linear infinite;

}

.cube__box span{

position:absolute;inset:0;display:grid;place-items:center;text-align:center;

font-weight:800;font-size:calc(var(--s,150px) / 9);letter-spacing:.02em;

color:var(--cy);

border:1px solid rgba(78,240,255,.5);

background:linear-gradient(160deg, rgba(78,240,255,.10), rgba(154,107,255,.10));

box-shadow:inset 0 0 28px rgba(78,240,255,.22), 0 0 22px rgba(78,240,255,.16);

backface-visibility:visible;

}

.cube__box span small{display:block;font-size:.52em;font-weight:600;color:#9fd8ff;letter-spacing:.06em}

.cube__box span:nth-child(1){transform:translateZ(calc(var(--s,150px) / 2))}

.cube__box span:nth-child(2){transform:rotateY(90deg) translateZ(calc(var(--s,150px) / 2))}

.cube__box span:nth-child(3){transform:rotateY(180deg) translateZ(calc(var(--s,150px) / 2))}

.cube__box span:nth-child(4){transform:rotateY(-90deg) translateZ(calc(var(--s,150px) / 2))}

.cube__box span:nth-child(5){transform:rotateX(90deg) translateZ(calc(var(--s,150px) / 2))}

.cube__box span:nth-child(6){transform:rotateX(-90deg) translateZ(calc(var(--s,150px) / 2))}

@keyframes spin{

0%{transform:rotateX(-18deg) rotateY(0deg)}

100%{transform:rotateX(-18deg) rotateY(360deg)}

}

@media (prefers-reduced-motion: reduce){

.cube__box,.scan{animation:none}

html{scroll-behavior:auto}

}

