}

.lead{font-size:clamp(16px,1.5vw,19px);color:#b9c8e2;max-width:70ch}

/ ── hero ── /

.hero{padding-top:clamp(36px,6vw,70px)}

.hero__grid{display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center}

@media(max-width:860px){.hero__grid{grid-template-columns:1fr}}

.hero h1 em{

